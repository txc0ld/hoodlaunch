# NEW business credentials only. Never copy the operator .env.local.
# Free launch uses no account keys. Set exact HTTPS origin, with no trailing slash.
APP_ORIGIN=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional server-only comma-separated exact wallet grants. Never use NEXT_PUBLIC_ or commit addresses.
PRO_WALLET_ALLOWLIST=
STRIPE_SECRET_KEY=
# Exact active prod_hoodlabs_pro USD 1500-minor-unit/month licensed per-unit price.
STRIPE_PRO_PRICE_ID=
STRIPE_PORTAL_CONFIGURATION_ID=
STRIPE_WEBHOOK_SECRET=
PINATA_JWT=
# Qualified release decision required before true; default is a non-signing preview.
LIVE_LAUNCH_ENABLED=false

# Public Reown project ID, safe in browser bundles. Restrict allowed origins in Reown.
# Blank retains browser-wallet / MetaMask instructions. Connect never enables live launch.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
