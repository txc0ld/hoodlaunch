# NEW business credentials only. Never copy the operator .env.local.
# Free launch uses no account keys. Set exact HTTPS origin, with no trailing slash.
APP_ORIGIN=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Keep false until real code delivery, verification, expiry/replay and sign-out pass end to end.
# Server-only and exact-true: missing, malformed or NEXT_PUBLIC_ values cannot enable sign-in.
EMAIL_SIGNIN_ENABLED=false
# Optional server-only comma-separated exact wallet grants. Never use NEXT_PUBLIC_ or commit addresses.
PRO_WALLET_ALLOWLIST=
STRIPE_SECRET_KEY=
# Exact active prod_hoodlabs_pro USD 1500-minor-unit/month licensed per-unit price.
STRIPE_PRO_PRICE_ID=
STRIPE_PORTAL_CONFIGURATION_ID=
STRIPE_WEBHOOK_SECRET=
PINATA_JWT=
# PONS new-token launching only. Qualified release decision required before true.
LIVE_LAUNCH_ENABLED=false

# Independent server-only capabilities; exact true only, otherwise disabled.
# Launching does not enable checkout or node funding/bridging.
PRO_SALES_ENABLED=false
NODE_FINANCE_ENABLED=false

# Public Reown project ID, safe in browser bundles. Restrict allowed origins in Reown.
# Blank retains browser-wallet / MetaMask instructions. Connect never enables live launch.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Keep disabled until account allowance and vault recovery release checks pass.
NODE_GENERATION_ENABLED=false

# Independent of LIVE_LAUNCH_ENABLED; requires generation, sign-in and Pro.
# Exact true only. Enable after wallet-session and trading release checks pass.
NODE_TRADING_ENABLED=false

# Enable only after migration005 and native wallet-auth acceptance checks.
WALLET_SIGNIN_ENABLED=false
